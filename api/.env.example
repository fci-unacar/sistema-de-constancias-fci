# URL del proyecto de Supabase (Project Settings > API > Project URL)
SUPABASE_URL=

# Llave service_role de Supabase (Project Settings > API > service_role).
# SECRETA: solo vive aquí, en el servidor. Nunca en el frontend ni en Git.
SUPABASE_SERVICE_ROLE_KEY=

# Origen exacto del frontend, para CORS. Sin barra final.
# En local: http://localhost:5173
FRONTEND_URL=

# Puerto de escucha. Render lo inyecta automáticamente; en local usa 3000.
PORT=3000

# Dominio de correo con el que entran los alumnos al portal /alumnos.
# Opcional: por defecto mail.unacar.mx.
ALUMNOS_DOMINIO=mail.unacar.mx

# Correo para avisarle al alumno cuando su solicitud queda lista o es
# rechazada. La misma cuenta de Gmail que usa Supabase para los códigos.
# SMTP_PASS es una "contraseña de aplicación" de Gmail (16 letras), NO la
# contraseña normal de la cuenta. SECRETA: solo aquí y en Render.
# Sin SMTP_USER y SMTP_PASS el sistema funciona igual, solo no manda avisos.
SMTP_USER=
SMTP_PASS=
# Opcionales: SMTP_HOST (smtp.gmail.com), SMTP_PORT (465) y
# SMTP_REMITENTE (Sistema de Constancias FCI).
